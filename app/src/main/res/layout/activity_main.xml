<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_app">

    <!-- Top Antigravity Header -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="Pocket gravity Logo" />

        <TextView
            android:id="@+id/tv_project_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="demo"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tv_connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Ready"
            android:textColor="@color/accent_green"
            android:textSize="11sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/bg_chip" />

        <ImageView
            android:id="@+id/btn_open_diagnostics"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_secondary"
            android:contentDescription="Settings"
            android:padding="4dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Main Content Frame for Views -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Antigravity Bottom Status Bar (Desktop Style on Mobile) -->
    <LinearLayout
        android:id="@+id/status_strip"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:orientation="horizontal"
        android:background="#0C0E12"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⋈"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⊗ 0  ⚠ 0"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:layout_marginStart="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_agent_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pocket gravity"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="@color/bg_surface"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/nav_agent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_icon_agent"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_agent"
                android:tint="@color/primary" />
            <TextView
                android:id="@+id/nav_text_agent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_agent"
                android:textSize="9.5sp"
                android:textColor="@color/primary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_editor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_icon_editor"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_editor"
                android:tint="@color/text_secondary" />
            <TextView
                android:id="@+id/nav_text_editor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_editor"
                android:textSize="9.5sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_explorer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_icon_explorer"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_explorer"
                android:tint="@color/text_secondary" />
            <TextView
                android:id="@+id/nav_text_explorer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_explorer"
                android:textSize="9.5sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_changes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_icon_changes"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_changes"
                android:tint="@color/text_secondary" />
            <TextView
                android:id="@+id/nav_text_changes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_changes"
                android:textSize="9.5sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_terminal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_icon_terminal"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_terminal"
                android:tint="@color/text_secondary" />
            <TextView
                android:id="@+id/nav_text_terminal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_terminal"
                android:textSize="9.5sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
